# Local development defaults
DJANGO_SECRET_KEY=change-this-secret-key
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Django -> FastAPI Gateway (never point this directly to MOSEC)
INFERENCE_GATEWAY_URL=http://127.0.0.1:8100/api/v1/inference
# Set to the private Gateway service origin on Cloud Run. Leave empty locally.
INFERENCE_GATEWAY_AUDIENCE=
INFERENCE_TIMEOUT_SECONDS=300
MODEL_VERSION=1.0.0
MAX_NIFTI_UPLOAD_BYTES=536870912

# PostgreSQL 17 through a local Cloud SQL Auth Proxy
DB_NAME=medical_cdss
DB_USER=postgres
DB_PASSWORD=replace-with-secret
DB_HOST=127.0.0.1
DB_PORT=5432
DB_CONN_MAX_AGE=60

# Set this to persist uploads in Cloud Storage.
GS_BUCKET_NAME=deep-learning-stroke2607-models-choi

GOOGLE_CLOUD_PROJECT=your-project-id
GOOGLE_APPLICATION_CREDENTIALS=C:/path/to/service-account.json
GS_BUCKET_NAME=deep-learning-stroke2607-models-choi

# Cloud Run production DB_HOST:
# /cloudsql/stroke-segmentation-123456:asia-southeast1:medical-cdss-pg17
