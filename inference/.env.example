# inference/.env.example

MOSEC_ADDRESS=0.0.0.0
MOSEC_PORT=8000

MODEL_BUCKET=your-private-model-bucket
MODEL_OBJECT=path/to/model.zip
MODEL_SHA256=replace-with-the-64-character-sha256
MODEL_ID=your-model-id
MODEL_VERSION=1.0.0
MODEL_FOLDS=0
MODEL_CHECKPOINT=checkpoint_best.pth
GOOGLE_CLOUD_PROJECT=your-gcp-project-id